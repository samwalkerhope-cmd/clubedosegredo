# Copie para .env (local) e cadastre as mesmas variáveis na Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Domínio usado para transformar o telefone em login (pode manter o padrão).
VITE_AUTH_EMAIL_DOMAIN=membros.exemplo.com
# Idioma do site: deixe vazio para português ou use "es" para o site em espanhol.
VITE_IDIOMA=

# Compra do Club Secreto em 1 clique: estas duas NÃO vão aqui nem na Vercel, e nunca com o prefixo VITE_.
# Ficam nos segredos da função "um-clique" (Supabase → Edge Functions → Secrets). Aqui só os nomes:
#   UM_CLIQUE_CHAVE   chave do serviço de cobrança (valor real colocado só no painel)
#   APP_ORIGIN        endereço do app, ex.: https://miclubdelsecreto.vercel.app
